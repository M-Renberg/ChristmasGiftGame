<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristmasGiftGame.MainPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="Red">
    <Grid>


        <skia:SKLottieView
            Source="Snow.json"
            RepeatCount="-1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>

            <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
                <!-- Header  -->
                <Label
                Text="Christmas Gift Game" 
                FontSize="32" 
                Style="{StaticResource Headline}" 
                SemanticProperties.HeadingLevel="Level1" 
                TextColor="AntiqueWhite" 
                HorizontalOptions="Center" 
                FontAttributes="Bold"
                FontFamily="Miriam"
                Padding="20"/>
                <!-- When adding players  -->
                <Entry x:Name="PlayerEntry" 
                   IsVisible="True"
                   Placeholder="lägg till spelare: " 
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"
                  />

                <Button Text="Lägg till"
                    x:Name="AddPlayer"
                    Clicked="AddPlayer_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--start game-->
                <Button Text="Starta spelet"
                    x:Name="StartGame"
                    IsVisible="true"
                    Clicked="StartGame_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                
                <!--inbetween-->
                <Grid
                    x:Name="MidGameGrid"
                    RowDefinitions="Auto, *" 
                    ColumnDefinitions="Auto, *"
                    IsVisible="False"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="20">
                    <!--dice game-->
                    <Button
                        x:Name="Playdice" 
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="PlayDice_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Spela tärning">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--random gift-->
                    <Button
                        x:Name="RandomGiveGifts"
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="10"
                        Margin="25"
                        Clicked="RandomGiveGift_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Slumpa ut presenter">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--card game-->
                    <Button
                        x:Name="PlayCards"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="PlayCards_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Spela julklaps spelet">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--back-->
                    <Button
                        x:Name="BackFromMid"
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="10"
                        Margin="25"
                        Clicked="BackMid_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Gå tillbaka">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
                <!--Options menu-->
                <Grid
                    RowDefinitions="Auto, *" 
                    ColumnDefinitions="Auto, *"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="20"
                    x:Name="OptionMenu"
                    IsVisible="False">
                    <Button
                      x:Name="BackOptionsMenu"
                      Grid.Row="0"
                      Grid.Column="0"
                      Margin="15"
                      Text="Tillbaka"
                      Clicked="OptionMenuBack_Clicked"
                      BackgroundColor="DarkSeaGreen"
                      MaximumWidthRequest="400">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <Button
                      x:Name="ContinueOptionMenu"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="15"
                      Text="Spela julklaps spelet"
                      Clicked="OptionMenuContinue_Clicked"
                      BackgroundColor="DarkSeaGreen"
                      MaximumWidthRequest="400">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
                <!--dice-->
                <Border
                    x:Name="DiceText"
                    IsVisible="false"
                    BackgroundColor="AntiqueWhite"
                    MaximumWidthRequest="150"
                    MaximumHeightRequest="150"
                    Stroke="DarkRed"
                    StrokeShape="RoundRectangle 10"
                    Padding="20">
                    <Label Text="{Binding DiceSideShown}"
                           FontSize="46"
                           TextColor="{Binding DiceColor}"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>
                <Button
                    x:Name="DiceRollButton"
                    Text="Rulla tärning"
                    IsVisible="false"
                    Clicked="DiceRoll_Clicked"
                    BackgroundColor="DarkSeaGreen"
                    MaximumWidthRequest="400">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--RandomGifts-->
                <Entry x:Name="RandomGiftEntry" 
                   IsVisible="false"
                   Placeholder="Skriv hur många paket som ska slumpas ut:" 
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"/>
                <Button
                    x:Name="RandomGiftButton"
                    Text="Tryck för att slumpa"
                    IsVisible="false"
                    Clicked="RandomGift_Clicked"
                    BackgroundColor="DarkSeaGreen"
                    MaximumWidthRequest="400">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!-- When playing the game -->
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Border
                    x:Name="PlayerList"
                    IsVisible="False"
                    BackgroundColor="AntiqueWhite"
                    Stroke="DarkRed"
                    StrokeShape="RoundRectangle 10"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                        <Grid RowDefinitions="auto, *">
                            <Label Text="Spelare:"
                                   Grid.Row="0"
                                   FontSize="26" 
                                   TextColor="Black"
                                   FontAttributes="Bold"/>
                            <CollectionView ItemsSource="{Binding Players}" Grid.Row="1"> <!--display players-->
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Padding="10">
                                            <Label Text="{Binding PlayerName}"
                                               TextColor="Black"
                                                FontSize="22"/>
                                        </StackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
                <!--cards-->
                <Border
                x:Name="CardInPlay"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="DarkRed"
                StrokeShape="RoundRectangle 10"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                            <Image
                        Source="{Binding CardImage}"
                        Aspect="AspectFit"
                        Opacity="0.9"
                        VerticalOptions="Center"
                        WidthRequest="80"
                        />

                            <Label Text="{Binding CurrentCard}" 
                       FontSize="24" 
                       TextColor="Black" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"
                       MaximumHeightRequest="300"
                       LineBreakMode="WordWrap"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
                <Button 
                    Text="Dra kort"
                    x:Name="DrawCard"
                    IsVisible="false"
                    Clicked="DrawCard_Clicked"
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
