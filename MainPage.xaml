<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristmasGiftGame.MainPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="Red">
    <Grid>


        <skia:SKLottieView
            Source="Snow.json"
            RepeatCount="-1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>

            <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
                <!-- When adding players  -->
                <Label
                Text="Christmas Gift Game" 
                FontSize="32" 
                Style="{StaticResource Headline}" 
                SemanticProperties.HeadingLevel="Level1" 
                TextColor="AntiqueWhite" 
                HorizontalOptions="Center" 
                FontAttributes="Bold"
                FontFamily="Miriam"
                Padding="20"/>
                <Entry x:Name="PlayerEntry" 
                   IsVisible="True"
                   Placeholder="lägg till spelare: " 
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"/>

                <Button Text="Lägg till"
                    x:Name="AddPlayer"
                    Clicked="AddPlayer_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--start game-->
                <Button Text="Starta spelet"
                    x:Name="StartGame"
                    IsVisible="true"
                    Clicked="StartGame_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--dice-->
                
                    <Border
                        x:Name="dicetext">
                        <Label Text=""/>
                    </Border>
                
                
                
                <!-- When playing the game -->
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Border
                    x:Name="PlayerList"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="DarkRed"
                    StrokeShape="RoundRectangle 10"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                        <Grid RowDefinitions="auto, *">
                            <Label Text="Spelare:"
                                   Grid.Row="0"
                                   FontSize="26" 
                                   TextColor="Black"
                                   FontAttributes="Bold"/>
                            <CollectionView ItemsSource="{Binding Players}" Grid.Row="1"> <!--display players-->
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Padding="10">
                                            <Label Text="{Binding PlayerName}"
                                               TextColor="Black"
                                                FontSize="22"/>
                                        </StackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
                <Button 
                Text="Dra kort"
                x:Name="DrawCard"
                IsVisible="false"
                Clicked="DrawCard_Clicked"
                MaximumWidthRequest="400"
                FontSize="22"
                BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                         Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <Border
                x:Name="CardInPlay"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="DarkRed"
                StrokeShape="RoundRectangle 10"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                            <Image
                        Source="{Binding CardImage}"
                        Aspect="AspectFit"
                        Opacity="0.9"
                        VerticalOptions="Center"
                        WidthRequest="80"
                        />

                            <Label Text="{Binding CurrentCard}" 
                       FontSize="24" 
                       TextColor="Black" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"
                       MaximumHeightRequest="300"
                       LineBreakMode="WordWrap"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
