<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristmasGiftGame.MainPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="Red">
    <Grid>
        <skia:SKLottieView
            Source="Snow.json"
            RepeatCount="-1"
            InputTransparent="True"
            HeightRequest="1000"
            WidthRequest="1300"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            />
        <ScrollView>
            <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
                <!-- Header  -->
                <Image Source="logo.png"
                       WidthRequest="600"
                       HeightRequest="129"
                       Opacity="0.9"
                       />
                <!-- When adding players  -->
                <Entry x:Name="PlayerEntry" 
                   IsVisible="True"
                   Margin="25"
                   Placeholder="lägg till spelare: "
                   PlaceholderColor="DarkSlateGray"
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"
                   FontSize="20"/>
                <Button Text="Lägg till"
                    x:Name="AddPlayer"
                    Clicked="AddPlayer_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--start game-->
                <Button Text="Starta spelet"
                    x:Name="StartGame"
                    IsVisible="true"
                    Clicked="StartGame_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>

                <!--inbetween-->
                <Grid
                    x:Name="MidGameGrid"
                    RowDefinitions="auto, auto, auto, auto" 
                    ColumnDefinitions="*"
                    IsVisible="False"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="20"
                    Margin="25">
                    <!--dice game-->
                    <Button
                        x:Name="Playdice" 
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="PlayDice_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Spela tärning">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--random gift-->
                    <Button
                        x:Name="RandomGiveGifts"
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="RandomGiveGift_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Slumpa ut presenter">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--card game-->
                    <Button
                        x:Name="PlayCards"
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="PlayCards_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Spela julklappsspelet">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--back-->
                    <Button
                        x:Name="BackFromMid"
                        Grid.Row="3"
                        Grid.Column="0"
                        Padding="10"
                        Margin="25"
                        Clicked="BackMid_Clicked" 
                        MaximumWidthRequest="400"
                        FontSize="22"
                        BackgroundColor="DarkSeaGreen"
                        Text="Gå tillbaka">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                </Grid>

                <!--dice-->
                <Border
                    x:Name="DiceText"
                    IsVisible="false"
                    BackgroundColor="AntiqueWhite"
                    MaximumWidthRequest="150"
                    MaximumHeightRequest="150"
                    Stroke="DarkRed"
                    StrokeShape="RoundRectangle 10"
                    Margin="25"
                    Padding="20">
                    <Label Text="{Binding DiceSideShown}"
                           FontSize="46"
                           TextColor="{Binding DiceColor}"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>
                <Button
                    x:Name="DiceRollButton"
                    Text="Rulla tärning"
                    Margin="15"
                    FontSize="22"
                    IsVisible="false"
                    Clicked="DiceRoll_Clicked"
                    BackgroundColor="DarkSeaGreen"
                    MaximumWidthRequest="400">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--RandomGifts-->
                <Entry x:Name="RandomGiftEntry" 
                   IsVisible="false"
                   Placeholder="Skriv hur många paket som ska slumpas ut:"
                   PlaceholderColor="DarkSlateGray"
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"
                   FontSize="16"
                   Margin="25"/>
                <Button
                    x:Name="RandomGiftButton"
                    Text="Tryck för att slumpa"
                    IsVisible="false"
                    Clicked="RandomGift_Clicked"
                    BackgroundColor="DarkSeaGreen"
                    MaximumWidthRequest="400"
                    FontSize="22">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--Random lista-->
                <Border x:Name="PlayerListRandom"
                        IsVisible="False"
                        BackgroundColor="AntiqueWhite"
                        Stroke="DarkRed"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="350"
                        Margin="25">
                    <Grid RowDefinitions="auto, *"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"
                          Padding="5">
                        <CollectionView ItemsSource="{Binding Players}" Grid.Row="1">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout Padding="10" Orientation="Horizontal">
                                        <Label  Text="{Binding PlayerName}"
                                                TextColor="Black"
                                                FontSize="22" />
                                        <Label Text=":    "
                                               TextColor="Black"
                                               FontSize="22"/>
                                        <Label  Text="{Binding GiftCount, StringFormat='Paket: {0}'}"
                                                TextColor="Red"
                                                FontSize="22"
                                                FontAttributes="Bold" />
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
                <!-- When playing the game -->
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Border
                    x:Name="PlayerList"
                    IsVisible="False"
                    BackgroundColor="AntiqueWhite"
                    Stroke="DarkRed"
                    StrokeShape="RoundRectangle 10"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Margin="25">
                        <Grid RowDefinitions="auto, *">
                            <Label Text="Spelare:"
                                   Grid.Row="0"
                                   FontSize="22" 
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <CollectionView ItemsSource="{Binding Players}" Grid.Row="1">
                                <!--display players-->
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Padding="10">
                                            <Label Text="{Binding PlayerName}"
                                               TextColor="Black"
                                                FontSize="18"
                                                   HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
                <!--cards-->
                <Border
                x:Name="CardInPlay"
                IsVisible="False"
                BackgroundColor="AntiqueWhite"
                Stroke="DarkRed"
                StrokeShape="RoundRectangle 10"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="350"
                Margin="25">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Image Grid.Column="0"
                               Source="{Binding CardImage}"
                               Aspect="AspectFit"
                               Opacity="0.9"
                               VerticalOptions="Center"
                               WidthRequest="80"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentCard}" 
                               FontSize="24" 
                               TextColor="Black" 
                               HorizontalTextAlignment="Start" 
                               VerticalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Border>
                <Button 
                    Text="Dra kort"
                    x:Name="DrawCard"
                    IsVisible="false"
                    Clicked="DrawCard_Clicked"
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                    </Button.Shadow>
                </Button>
                <!--Options menu-->
                <Grid
                    RowDefinitions="Auto, Auto" 
                    ColumnDefinitions="*"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="5"
                    x:Name="OptionMenu"
                    IsVisible="False">
                    <Button
                      x:Name="BackOptionsMenu"
                      Grid.Row="0"
                      Margin="5"
                      Text="Tillbaka"
                      Clicked="OptionMenuBack_Clicked"
                      BackgroundColor="DarkSeaGreen"
                      MaximumWidthRequest="400"
                      FontSize="20">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <Button
                          x:Name="ContinueOptionMenu"
                          Grid.Row="1"
                          Margin="10"
                          Text="Spela julklappsspelet"
                          Clicked="OptionMenuContinue_Clicked"
                          BackgroundColor="DarkSeaGreen"
                          MaximumWidthRequest="400"
                          FontSize="20">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>
                    <!--quit game-->
                    <Button
                          x:Name="QuitGameButton"
                          IsVisible="False"
                          Margin="10"
                          Text="Avsluta Spelet"
                          Clicked="QuitGame_Clicked"
                          BackgroundColor="DarkSeaGreen"
                          MaximumWidthRequest="400"
                          FontSize="24">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                        </Button.Shadow>
                    </Button>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
