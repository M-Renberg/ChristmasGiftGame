<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristmasGiftGame.MainPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="Red">
    <Grid>


        <skia:SKLottieView
            Source="Snow.json"
            RepeatCount="-1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>

            <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Christmas Gift Game" 
                FontSize="26" 
                Style="{StaticResource Headline}" 
                SemanticProperties.HeadingLevel="Level1" 
                TextColor="AntiqueWhite" 
                HorizontalOptions="Center" 
                FontAttributes="Bold" 
                Padding="20"/>
            <Entry x:Name="PlayerEntry" 
                   Placeholder="lägg till spelare: " 
                   BackgroundColor="AntiqueWhite"
                   TextColor="Black"
                   MaximumWidthRequest="400"/>
            <Button Text="Lägg till" 
                    Clicked="AddPlayer_Clicked" 
                    MaximumWidthRequest="400"
                    FontSize="22"
                    BackgroundColor="DarkSeaGreen"/>
            <CollectionView ItemsSource="{Binding Players}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Name}" TextColor="Black"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button 
                Text="Dra kort" 
                Clicked="DrawCard_Clicked"
                MaximumWidthRequest="400"
                FontSize="22"
                BackgroundColor="DarkSeaGreen"/>
            <Border
                x:Name="CardInPlay"
                BackgroundColor="White"
                Stroke="DarkRed"
                StrokeShape="RoundRectangle 10"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.3" Offset="5,5" Radius="20"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Image
                        Source="{Binding CardImage}"
                        Aspect="AspectFit"
                        Opacity="0.9"
                        VerticalOptions="Center"
                        WidthRequest="80"
                        />

                    <Label Text="{Binding CurrentCard}" 
                       FontSize="24" 
                       TextColor="Black" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"
                       MaximumHeightRequest="300"
                       LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
                </Grid>
                </Border>
            
        </VerticalStackLayout>
        
    </ScrollView>
    </Grid>

</ContentPage>
