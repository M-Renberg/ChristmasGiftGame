<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristmasGiftGame.FaqPage"
             Title="FaqPage"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             BackgroundColor="Red">
    <Grid>
        <skia:SKLottieView
        Source="Snow.json"
        RepeatCount="-1"
        InputTransparent="True"
        HeightRequest="1000"
        WidthRequest="1300"
        VerticalOptions="Fill"
        HorizontalOptions="Fill"
        />
        <ScrollView>
            <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
                <!-- Header  -->
                <Image Source="logo.png"
                       WidthRequest="600"
                       HeightRequest="129"
                       Opacity="0.9"
                       />
                <Border
                    x:Name="FaqBorder"
                        IsVisible="True"
                        BackgroundColor="AntiqueWhite"
                        Stroke="DarkRed"
                        StrokeShape="RoundRectangle 10"
                        Padding="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="350"
                        Margin="25">
                    <StackLayout>
                    <Label
                        Text="Hur man spelar:"
                        FontSize="26"
                        TextColor="Black"
                        Padding="30"/>
                    <Label
                        Text="1: Börja med att lägga till alla spelare i spelet"
                        
                        FontSize="20"
                        TextColor="Black"/>
                        <Label Text=" "/>
                        <Label
                        Text="2: Ni kan välja att antingen börja spela direkt med dom julklapparna ni själv har tagit mer er.
                        Annars kan ni dela up julklapparna genom att antingen slå tärning eller be appen att slumpa ut alla julklappar"
                        FontSize="20"
                        TextColor="Black"
                        />
                    <Label Text=" "/>
                    <Label
                        Text="3: Efter att alla julklappar är utdelade är det dags att börja spela.
                        Ni turas om att trycka på 'Dra kort' knappen för att få upp ett kort med instruktioner. Ni fortsätter tills alla kort är slut, och då är spelet över."
                        FontSize="20"
                        TextColor="Black"
                        />
                        <Label Text=" "/>
                        <Label Text="Lycka till!"
                               FontSize="22"
                               TextColor="black"/>
                    </StackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>